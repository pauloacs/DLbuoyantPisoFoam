    {
        type            calculated;
        value           uniform 100000;
    }
    geometry_z_bot
    {
        type            calculated;
        value           uniform 100000;
    }
    geometry_y_bot
    {
        type            calculated;
        value           uniform 100000;
    }
    geometry_inlet
    {
        type            calculated;
        value           uniform 100000;
    }
    geometry_y_top
    {
        type            calculated;
        value           uniform 100000;
    }
    geometry_outlet
    {
        type            calculated;
        value           uniform 100000;
    }
    geometry_obstacle
    {
        type            calculated;
        value           uniform 100000;
    }
}


